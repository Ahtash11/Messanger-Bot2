# ── Server ──────────────────────────────────────────────
PORT=3000
# Set to true to test with fake sample products instead of your real store —
# see src/services/mockCatalog.js. Set to false (or remove) once you connect
# your real WooCommerce catalog below.
MOCK_CATALOG=true

# ── Meta / Messenger Platform ──────────────────────────
# From your Facebook App > Messenger > Settings
PAGE_ACCESS_TOKEN=
# Any random string you choose yourself — used to verify the webhook with Meta
VERIFY_TOKEN=
# App secret, used to verify incoming webhook signatures (recommended)
APP_SECRET=

# ── Telegram (for sending YOU the order summaries) ──────
# From @BotFather after you create a bot
TELEGRAM_BOT_TOKEN=
# Your personal chat id — get this from @userinfobot (see README)
TELEGRAM_OWNER_CHAT_ID=

# ── Anthropic (Claude) ──────────────────────────────────
ANTHROPIC_API_KEY=

# ── OpenAI (Whisper, for voice note transcription) ─────
OPENAI_API_KEY=

# ── Store info (used in the bot's system prompt) ───────
STORE_NAME=المورد التركي
STORE_DESCRIPTION=محل ملابس رجالي، يبيع قمصان وبناطيل وأحذية وجاكيتات

# ── WooCommerce ─────────────────────────────────────────
WOOCOMMERCE_URL=https://yourstore.com
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
