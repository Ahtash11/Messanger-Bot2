# ── Server ──────────────────────────────────────────────
PORT=3000

# Path to the LIVE, WRITABLE inventory file. In production, point this at a
# Railway Volume mount (e.g. /data/products.json) so stock changes survive
# redeploys. Leave blank for local testing (writes won't persist).
INVENTORY_FILE_PATH=

# Optional — set any random string to protect the /debug/inventory endpoint
# (view live stock numbers in your browser). Leave blank and it's open to
# anyone with the URL.
DEBUG_KEY=

# ── In-store POS / admin system ─────────────────────────
# Path to the SQLite database file (sales, stock, staff accounts, expenses,
# customers). In production, point this at a Railway Volume mount (e.g.
# /data/store.db) — same idea as INVENTORY_FILE_PATH above. Leave blank for
# local testing (data won't persist between restarts).
DATABASE_PATH=

# Any long random string — signs the login session cookie for /pos and
# /admin. Generate one with `openssl rand -hex 32` or similar.
SESSION_SECRET=

# Used ONCE, the very first time the server boots with an empty database,
# to create the first admin login. Safe to leave set permanently — ignored
# on every later boot once any account exists. After first login, create
# more accounts (admin or employee) from the /admin/staff page.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── Meta / Messenger Platform ──────────────────────────
# Single Facebook Page: just fill this in.
PAGE_ACCESS_TOKEN=
# Running on MORE than one Facebook Page? Use this instead — one shared
# catalog/Telegram, format "pageId:token,pageId:token,...":
# PAGE_ACCESS_TOKENS=123456:EAAxxxxxxx,789012:EAAyyyyyyy
VERIFY_TOKEN=
APP_SECRET=

# ── Telegram (for sending YOU the order summaries) ──────
TELEGRAM_BOT_TOKEN=
# For one person, use TELEGRAM_OWNER_CHAT_ID. For more than one (e.g. you
# and a business partner), use TELEGRAM_OWNER_CHAT_IDS with a comma between
# ids instead, e.g. TELEGRAM_OWNER_CHAT_IDS=111111,222222
TELEGRAM_OWNER_CHAT_ID=
# Any random string you choose — used to verify webhook calls really come
# from Telegram (see README for the one-time setup step)
TELEGRAM_WEBHOOK_SECRET=

# ── Anthropic (Claude) ──────────────────────────────────
ANTHROPIC_API_KEY=

# ── OpenAI (Whisper, for voice note transcription) ─────
OPENAI_API_KEY=

# ── Store info (used in the bot's system prompt) ───────
STORE_NAME=المورد التركي
STORE_DESCRIPTION=محل ملابس رجالي، يبيع قمصان وبناطيل وأحذية وجاكيتات
